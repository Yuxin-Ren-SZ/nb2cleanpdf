#!/usr/bin/env zsh
# ---------------------------------------------------------------------------
# nb2cleanpdf — export clean PDFs of Jupyter notebooks: re-execute every
# notebook below the project directory (default: the current one) from scratch
# with the project's uv virtualenv (or a venv / conda env of your choice), then
# export each one to PDF (into ./PDF).
#
#   nb2cleanpdf -h        for usage
#
# Requirements (checked at start-up; missing ones can be installed on the spot):
#   required : a uv-created venv (./.venv) containing nbformat, nbclient, ipykernel
#              (or --env local PATH / --env conda NAME|PREFIX)
#   PDF      : nbconvert + an installed Chrome/Edge/Brave/Chromium, driven by
#              playwright in a uv-cached env outside the venv ("chrome", default)
#              or the same browser's headless print CLI ("chrome-cli")
#              or nbconvert + playwright's bundled Chromium ("webpdf")
#              or nbconvert + xelatex + pandoc ("latex")
#   optional : fzf >= 0.36 for the interactive picker (text menu otherwise)
# ---------------------------------------------------------------------------

emulate -R zsh
setopt extended_glob pipe_fail
zmodload zsh/datetime || { print -u2 "zsh/datetime module unavailable"; exit 1 }
autoload -Uz is-at-least

SCRIPT=${0:t}
VERSION=0.3.0            # bumped in the release commit; the tag is v$VERSION

# ---------- colours / messages ---------------------------------------------
if [[ -t 1 ]]; then
  R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' B=$'\e[1m' D=$'\e[2m' N=$'\e[0m' EL=$'\r\e[K'
  IS_TTY=1
else
  R= G= Y= C= B= D= N= EL=$'\n'
  IS_TTY=0
fi
if [[ -t 2 ]]; then     # stderr is coloured independently (e.g. `2>err.log`)
  ER=$'\e[31m' EY=$'\e[33m' ED=$'\e[2m' EN=$'\e[0m'
else
  ER= EY= ED= EN=
fi
info() { print -r -- "${C}::${N} $*" }
warn() { print -ru2 -- "${EY}warning:${EN} $*" }
die()  { print -ru2 -- "${ER}error:${EN} $*"; exit 1 }
hint() { print -ru2 -- "       ${ED}\$${EN} $*" }
# drop ANSI colour codes (e.g. from IPython tracebacks) unless stdout is a terminal
strip_ansi() { if (( IS_TTY )); then cat; else command sed $'s/\e\\[[0-9;?]*[A-Za-z]//g'; fi }

usage() {
  cat <<EOF
${B}${SCRIPT}${N} — export clean PDFs of Jupyter notebooks: re-run every notebook
below the project directory from scratch with its uv virtualenv (.venv) — or
another venv / conda environment — then export each one to PDF.

${B}Usage:${N} ${SCRIPT} [options] [DIR]
       ${SCRIPT} clean [-n] [-y] [--keep N] [--pdfs [-o DIR] [-i/-e PATTERN]] [DIR]
       ${SCRIPT} -h | -V        help / version

  DIR is the project directory (default: the current directory). Paths given
  in options (-o, --env, --browser, --config) are relative to where you run the
  command; paths in a config file are relative to that file.

${B}Environment${N}  (where the notebooks run)
      --env uv            default: the uv-created venv ./.venv
      --env=uv:DIR        a uv-created venv elsewhere (same as --venv DIR)
      --env local PATH    any standard venv (python -m venv, virtualenv, poetry, pdm…)
      --env conda NAME    a conda / mamba / micromamba env, by name or prefix path
                          (activated like 'conda activate', incl. activate.d scripts)
  Missing packages are installed with the environment's own tool (uv, pip, or
  conda/mamba/micromamba from conda-forge) — shown first, run only if you agree.

${B}Config file${N}  (read only with --config; command-line options override it)
      --config [FILE]     read FILE (default: .nb2cleanpdf.toml in the project)
  Top-level 'key = value' lines (a TOML subset). Keys: env, env_spec, engine,
  browser, output_dir, timeout, include, exclude, allow_errors, backup, e.g.
      env = "conda"
      env_spec = "myenv"
      exclude = ["*scratch*", "(#i)*draft*"]

${B}Selection${N}
  -i, --include PATTERN   only keep notebooks matching PATTERN (repeatable, OR-ed)
  -e, --exclude PATTERN   drop notebooks matching PATTERN (repeatable, applied after -i)
  -y, --yes               skip the interactive picker and confirmation
  -n, --dry-run           list the notebooks that would be processed, then exit

${B}Execution${N}
  -t, --timeout SEC       per-cell timeout in seconds (default: no timeout)
      --allow-errors      don't stop a notebook at the first failing cell
                          (--no-allow-errors: stop, overriding the config)
      --no-exec           don't re-run notebooks, only export PDFs
      --no-backup         don't back up notebooks before overwriting them
                          (--backup: do, overriding the config)
      --sync              run 'uv sync' before starting (uv environments only)

${B}Dependencies${N}
  Missing dependencies are listed with the command that installs each one;
  you're then asked whether to run those commands. Optional ones (fzf) are
  only mentioned as a tip unless something required is missing too.
      --install-deps      install missing dependencies (incl. optional) without asking

${B}PDF export${N}
      --no-pdf            skip PDF export
      --engine ENGINE     auto (default): chrome if a Chromium-based browser is
                          installed, else webpdf
                          chrome     : reuse your installed Chrome/Edge/Brave/Chromium,
                                       driven by playwright (kept in uv's cache, not
                                       added to your environment)
                          chrome-cli : same browser via its headless --print-to-pdf
                                       (no playwright; waits less precisely for MathJax)
                          webpdf     : playwright's own Chromium (~/Library/Caches/ms-playwright)
                          latex      : xelatex + pandoc
      --browser PATH      browser for chrome/chrome-cli (binary or .app bundle;
                          also \$NB2CLEANPDF_BROWSER)
  -o, --output-dir DIR    put PDFs in DIR, mirroring the folder layout
                          (default: PDF/ in the project directory;
                          '-o .' inside the project puts them next to each notebook)

${B}Cleaning${N}  (${SCRIPT} clean)
  Lists what runs left behind, then asks before removing it:
  run records in .nb2cleanpdf/ (logs, backups, failed copies), half-written
  notebook temp files, and — from runs that were hard-killed — orphaned temp
  dirs and orphaned helper/browser processes. A run in progress is never touched.
  Uses the macOS 'trash' command when available, so records can be restored.
  -n, --dry-run           check only, remove nothing
  -y, --yes               don't ask
      --keep N            keep the newest N run records (default 0)
      --pdfs              also remove exported PDFs of the (filtered) notebooks

${B}Patterns${N}
  zsh globs with extended_glob. A pattern without '/' is matched against the
  file name; with '/', against the path relative to here ('*' also crosses '/').
  A plain word (no wildcard) matches anywhere in the path ('eda', 'analysis').
  Prefix (#i) for case-insensitive. ${B}Always quote patterns.${N}

${B}Examples${N}
  ${SCRIPT} -i 'fig*' -e '*scratch*'
  ${SCRIPT} -i 'analysis/*' -o pdf -t 900
  ${SCRIPT} -e '(#i)*draft*' -y --no-pdf
  ${SCRIPT} clean -n                 # just check
  ${SCRIPT} clean --keep 2           # clean, but keep the two newest runs
EOF
}

# ---------- argument parsing -------------------------------------------------
typeset -a INCLUDES EXCLUDES
ENV_KIND=uv ENV_SPEC= PROJECT_OPT= TIMEOUT=-1 ENGINE=auto PDF_DIR= BROWSER_OPT=${NB2CLEANPDF_BROWSER:-} PDF_TIMEOUT=300
MODE=run KEEP_RUNS=0 KEEP_SET=0 CLEAN_PDFS=0 CONFIG_SET=0 CONFIG_FILE=
ASSUME_YES=0 INSTALL_DEPS=0 DRY_RUN=0 ALLOW_ERRORS=0 DO_EXEC=1 DO_PDF=1 DO_BACKUP=1 DO_SYNC=0
# options given on the command line; a config file (--config) only fills the others
typeset -A CLI_SET
[[ -n $BROWSER_OPT ]] && CLI_SET[browser]=1      # $NB2CLEANPDF_BROWSER counts as given
typeset -A CFG_FROM                               # key -> 1 when the value came from the config

need_arg() { [[ $# -ge 2 && -n $2 ]] || die "option '$1' needs an argument" }
ENV_KINDS='uv, local or conda'
set_env() {   # $1 = KIND or KIND:SPEC (from --env / --env=)
  [[ -n ${CLI_SET[env]:-} ]] && die "choose the environment once (--env / --venv given twice)"
  CLI_SET[env]=1
  ENV_KIND=${1%%:*} ENV_SPEC=
  [[ $1 == *:* ]] && ENV_SPEC=${1#*:}
  [[ $ENV_KIND == (uv|local|conda) ]] || die "--env must be $ENV_KINDS (got '$ENV_KIND')"
}

while (( $# )); do
  case $1 in
    -h|--help)        usage; exit 0 ;;
    -V|--version)     print -r -- "$SCRIPT $VERSION"; exit 0 ;;
    -i|--include)     need_arg "$@"; INCLUDES+=("$2"); CLI_SET[include]=1; shift 2 ;;
    --include=*)      INCLUDES+=("${1#*=}"); CLI_SET[include]=1; shift ;;
    -e|--exclude)     need_arg "$@"; EXCLUDES+=("$2"); CLI_SET[exclude]=1; shift 2 ;;
    --exclude=*)      EXCLUDES+=("${1#*=}"); CLI_SET[exclude]=1; shift ;;
    -t|--timeout)     need_arg "$@"; TIMEOUT=$2; CLI_SET[timeout]=1; shift 2 ;;
    --timeout=*)      TIMEOUT=${1#*=}; CLI_SET[timeout]=1; shift ;;
    -o|--output-dir)  need_arg "$@"; PDF_DIR=$2; CLI_SET[output_dir]=1; shift 2 ;;
    --output-dir=*)   PDF_DIR=${1#*=}; CLI_SET[output_dir]=1; shift ;;
    --env)            need_arg "$@"; set_env "$2"; shift 2
                      # local and conda need a path / name: take the next argument
                      if [[ $ENV_KIND == (local|conda) && -z $ENV_SPEC ]]; then
                        [[ $# -ge 1 && -n $1 && $1 != -* ]] || \
                          die "--env $ENV_KIND needs a $([[ $ENV_KIND == local ]] && print path || print 'name or path'), e.g. --env $ENV_KIND $([[ $ENV_KIND == local ]] && print ./venv || print myenv)"
                        ENV_SPEC=$1; shift
                      fi ;;
    --env=*)          set_env "${1#*=}"; shift ;;
    --venv)           need_arg "$@"; set_env "uv:$2"; shift 2 ;;
    --venv=*)         set_env "uv:${1#*=}"; shift ;;
    --config)         CONFIG_SET=1; shift
                      # optional FILE: only an existing file (the project DIR is a directory)
                      if [[ $# -ge 1 && -f $1 ]]; then CONFIG_FILE=$1; shift
                      elif [[ $# -ge 1 && $1 == *.toml ]]; then die "config file not found: '$1'"; fi ;;
    --config=*)       CONFIG_SET=1; CONFIG_FILE=${1#*=}
                      [[ -n $CONFIG_FILE ]] || die "option '--config=' needs a file"; shift ;;
    --engine)         need_arg "$@"; ENGINE=$2; CLI_SET[engine]=1; shift 2 ;;
    --engine=*)       ENGINE=${1#*=}; CLI_SET[engine]=1; shift ;;
    --browser)        need_arg "$@"; BROWSER_OPT=$2; CLI_SET[browser]=1; shift 2 ;;
    --browser=*)      BROWSER_OPT=${1#*=}; CLI_SET[browser]=1; shift ;;
    -y|--yes)         ASSUME_YES=1; shift ;;
    -n|--dry-run)     DRY_RUN=1; shift ;;
    --allow-errors)   ALLOW_ERRORS=1; CLI_SET[allow_errors]=1; shift ;;
    --no-allow-errors) ALLOW_ERRORS=0; CLI_SET[allow_errors]=1; shift ;;
    --no-exec)        DO_EXEC=0; shift ;;
    --no-pdf)         DO_PDF=0; shift ;;
    --backup)         DO_BACKUP=1; CLI_SET[backup]=1; shift ;;
    --no-backup)      DO_BACKUP=0; CLI_SET[backup]=1; shift ;;
    --sync)           DO_SYNC=1; shift ;;
    --install-deps)   INSTALL_DEPS=1; shift ;;
    --keep)           need_arg "$@"; KEEP_RUNS=$2; KEEP_SET=1; shift 2 ;;
    --keep=*)         KEEP_RUNS=${1#*=}; KEEP_SET=1; shift ;;
    --pdfs)           CLEAN_PDFS=1; shift ;;
    clean)            [[ $MODE == run ]] || die "'clean' given twice"; MODE=clean; shift ;;
    --)               shift; (( $# )) && die "unexpected argument '$1'"; break ;;
    -*)               die "unknown option '$1' (see $SCRIPT -h)" ;;
    *)
      if [[ -d $1 && -z $PROJECT_OPT ]]; then PROJECT_OPT=$1; shift; continue; fi
      [[ -d $1 ]] && die "only one project directory can be given ('$PROJECT_OPT', '$1')"
      die "unexpected argument '$1' — not a directory. Did the shell expand an unquoted pattern? Quote it: -i '*.ipynb'" ;;
  esac
done

# Paths given on the command line are relative to where you are; paths in a
# config file are relative to the file; everything else (.venv, notebooks, PDF/,
# .nb2cleanpdf/) is relative to the project dir.
START_DIR=$PWD
[[ -n $PDF_DIR ]] && PDF_DIR=${PDF_DIR:a}
[[ -n $BROWSER_OPT ]] && BROWSER_OPT=${BROWSER_OPT:a}
[[ -n $CONFIG_FILE ]] && CONFIG_FILE=${CONFIG_FILE:a}
# a spec with '/' is a path (a conda env name has none)
[[ -n $ENV_SPEC && ( $ENV_KIND != conda || $ENV_SPEC == */* ) ]] && ENV_SPEC=${ENV_SPEC:a}
if [[ -n $PROJECT_OPT ]]; then
  cd -- $PROJECT_OPT || die "cannot enter project directory '$PROJECT_OPT'"
fi

# ---------- config file (only with --config) ------------------------------------
# A flat subset of TOML, parsed here because it is read before any Python is
# chosen: `key = value` lines, # comments; values are "strings" / 'strings',
# integers, true / false, or one-line arrays of strings. CLI > config > default.
CFG_KEYS=(env env_spec engine browser output_dir timeout include exclude allow_errors backup)
cfg_err() { die "$CONFIG_FILE:$1: $2" }
cfg_string() {   # consume a quoted string from the front of CFG_REST into REPLY
  local q=${CFG_REST[1]} out= c
  integer i=2
  [[ $q == [\"\'] ]] || return 1
  while (( i <= $#CFG_REST )); do
    c=${CFG_REST[i]}
    if [[ $c == $q ]]; then REPLY=$out; CFG_REST=${CFG_REST[i+1,-1]}; return 0; fi
    if [[ $q == \" && $c == \\ ]]; then
      (( i++ )); c=${CFG_REST[i]}
      case $c in n) c=$'\n' ;; t) c=$'\t' ;; \"|\\) ;; *) return 1 ;; esac
    fi
    out+=$c; (( i++ ))
  done
  return 1
}
cfg_path() {     # $1 = path from the config -> absolute, relative to the config file
  local p=$1
  [[ $p == \~ || $p == \~/* ]] && p=$HOME${p#\~}
  [[ $p == /* ]] || p=${CONFIG_FILE:h}/$p
  print -r -- ${p:a}
}
load_config() {
  local line key type val
  local -a arr
  local -A seen
  integer n=0
  [[ -f $CONFIG_FILE ]] || die "config file not found: '$CONFIG_FILE' (--config)"
  [[ -r $CONFIG_FILE ]] || die "config file not readable: '$CONFIG_FILE'"
  while IFS= read -r line || [[ -n $line ]]; do
    (( n++ ))
    line=${line##[[:space:]]#}
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == \[* ]] && cfg_err $n "sections are not supported — use top-level 'key = value' lines"
    [[ $line =~ '^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$' ]] || \
      cfg_err $n "expected 'key = value'"
    key=$match[1] CFG_REST=$match[2]
    (( ${CFG_KEYS[(Ie)$key]} )) || cfg_err $n "unknown key '$key' (known: ${(j:, :)CFG_KEYS})"
    [[ -n ${seen[$key]:-} ]] && cfg_err $n "'$key' is set twice (also on line $seen[$key])"
    seen[$key]=$n
    arr=()
    if [[ $CFG_REST == \[* ]]; then
      type=array CFG_REST=${CFG_REST#\[}
      while true; do
        CFG_REST=${CFG_REST##[[:space:]]#}
        [[ $CFG_REST == \]* ]] && { CFG_REST=${CFG_REST#\]}; break }
        cfg_string || cfg_err $n "'$key': arrays may only hold quoted strings, on one line"
        arr+=("$REPLY")
        CFG_REST=${CFG_REST##[[:space:]]#}
        if [[ $CFG_REST == ,* ]]; then CFG_REST=${CFG_REST#,}
        elif [[ $CFG_REST != \]* ]]; then cfg_err $n "'$key': expected ',' or ']' in the array"; fi
      done
    elif cfg_string; then type=string val=$REPLY
    elif [[ $CFG_REST =~ '^(true|false)(.*)$' ]]; then type=bool val=$match[1] CFG_REST=$match[2]
    elif [[ $CFG_REST =~ '^(-?[0-9]+)(.*)$' ]]; then type=int val=$match[1] CFG_REST=$match[2]
    else cfg_err $n "'$key': value must be a quoted string, an integer, true/false or [\"…\", …]"
    fi
    CFG_REST=${CFG_REST##[[:space:]]#}
    [[ -z $CFG_REST || $CFG_REST == \#* ]] || cfg_err $n "unexpected text after the value: $CFG_REST"

    case $key:$type in
      (env|env_spec|engine|browser|output_dir):string|timeout:int|(allow_errors|backup):bool) ;;
      (include|exclude):string) type=array arr=("$val") ;;
      (include|exclude):array) ;;
      *) cfg_err $n "'$key' can't be $type" ;;
    esac
    # the environment is chosen as a whole: --env/--venv overrides both env keys
    [[ -n ${CLI_SET[${key%_spec}]:-} ]] && continue
    CFG_FROM[$key]=1
    case $key in
      env)          ENV_KIND=$val ;;
      env_spec)     ENV_SPEC=$val ;;
      engine)       ENGINE=$val ;;
      browser)      BROWSER_OPT=$(cfg_path $val) ;;
      output_dir)   PDF_DIR=$(cfg_path $val) ;;
      timeout)      TIMEOUT=$val ;;
      include)      INCLUDES=("${arr[@]}") ;;
      exclude)      EXCLUDES=("${arr[@]}") ;;
      allow_errors) [[ $val == true ]]; ALLOW_ERRORS=$(( ! $? )) ;;
      backup)       [[ $val == true ]]; DO_BACKUP=$(( ! $? )) ;;
    esac
  done <$CONFIG_FILE
  if (( $+CFG_FROM[env] || $+CFG_FROM[env_spec] )); then
    [[ $ENV_KIND == (uv|local|conda) ]] || cfg_err $seen[env] "env must be $ENV_KINDS (got '$ENV_KIND')"
    [[ -n $ENV_SPEC || $ENV_KIND == uv ]] || die "$CONFIG_FILE: env = \"$ENV_KIND\" needs env_spec (a $([[ $ENV_KIND == local ]] && print path || print 'name or path'))"
    [[ -n $ENV_SPEC && ( $ENV_KIND != conda || $ENV_SPEC == */* ) ]] && ENV_SPEC=$(cfg_path $ENV_SPEC)
  fi
}
if (( CONFIG_SET )); then
  [[ -n $CONFIG_FILE ]] || CONFIG_FILE=$PWD/.nb2cleanpdf.toml
  load_config
  info "config: ${B}${CONFIG_FILE/#$START_DIR\//}${N}"
fi
# where a value came from, for error messages: $1 = config key, $2 = CLI option
src() { (( $+CFG_FROM[$1] )) && print -r -- "'$1' in ${CONFIG_FILE/#$START_DIR\//}" || print -r -- $2 }
[[ $ENV_KIND == (local|conda) && -z $ENV_SPEC ]] && \
  die "$(src env --env) $ENV_KIND needs a $([[ $ENV_KIND == local ]] && print path || print 'name or path'), e.g. --env=$ENV_KIND:$([[ $ENV_KIND == local ]] && print ./venv || print myenv)"

[[ $KEEP_RUNS == <-> ]] || die "--keep must be a non-negative integer (got '$KEEP_RUNS')"
if [[ $MODE == run ]] && (( KEEP_SET || CLEAN_PDFS )); then
  die "--keep and --pdfs only apply to '$SCRIPT clean'"
fi
[[ $TIMEOUT == (-|)<-> ]] || die "$(src timeout --timeout) must be an integer (got '$TIMEOUT')"
[[ $ENGINE == (auto|chrome|chrome-cli|webpdf|latex) ]] || \
  die "$(src engine --engine) must be auto, chrome, chrome-cli, webpdf or latex (got '$ENGINE')"
(( DO_EXEC || DO_PDF )) || die "--no-exec together with --no-pdf leaves nothing to do"
(( DO_EXEC )) || DO_BACKUP=0
(( DO_SYNC )) && [[ $ENV_KIND != uv ]] && \
  die "--sync runs 'uv sync' and only applies to a uv environment (the environment is $(src env --env) $ENV_KIND)"

[[ -z $PDF_DIR ]] && PDF_DIR=$PWD/PDF
# commands shown for manual installation must also work from where you are
CD_PFX=; [[ $PWD != $START_DIR ]] && CD_PFX="cd ${(q)PWD} && "

# The environment's directory, when known without asking a conda manager (used
# to keep it out of notebook discovery); a conda env given by name is resolved
# later (resolve_env).
ENV_DIR=
case $ENV_KIND in
  uv)    ENV_DIR=${ENV_SPEC:-$PWD/.venv} ;;
  local) ENV_DIR=$ENV_SPEC ;;
  conda) [[ $ENV_SPEC == /* ]] && ENV_DIR=$ENV_SPEC ;;
esac
typeset -a ALL NBS
discover() {
  local -a prune=( -name '.?*' -o -name node_modules -o -name __pycache__ -o -name site-packages )
  local env_rel=${ENV_DIR#$PWD/}
  [[ -n $ENV_DIR && $env_rel != /* ]] && prune+=( -o -path "./$env_rel" )
  [[ -n $PDF_DIR && $PDF_DIR == $PWD/* ]] && prune+=( -o -path "./${PDF_DIR#$PWD/}" )
  local -a out
  out=( ${(0)"$(command find . -mindepth 1 \( -type d \( "${prune[@]}" \) -prune \) \
          -o \( -type f -iname '*.ipynb' ! -name '*-checkpoint.ipynb' -print0 \) 2>/dev/null)"} )
  ALL=( ${(o)${out#./}} )
}

matches_any() {         # $1 = relative path, rest = patterns
  local p=$1 base=${1:t} pat
  shift
  for pat in "$@"; do
    if [[ $pat != *[\*\?\[\]\(\)\#\^\~\<\>\|]* ]]; then
      [[ $p == *${pat}* ]] && return 0             # plain word: substring of the path
    elif [[ $pat == */* ]]; then
      [[ $p == ${~pat} ]] && return 0              # glob with '/': whole relative path
    else
      [[ $base == ${~pat} ]] && return 0           # glob without '/': file name only
    fi
  done
  return 1
}

filter_notebooks() {    # ALL -> NBS
  local f
  NBS=()
  for f in "${ALL[@]}"; do
    (( $#INCLUDES )) && ! matches_any "$f" "${INCLUDES[@]}" && continue
    (( $#EXCLUDES )) &&   matches_any "$f" "${EXCLUDES[@]}" && continue
    NBS+=("$f")
  done
}

# ---------- `nb2cleanpdf clean`: check for and remove leftovers --------------------
# What a run can leave behind, and how each is recognised:
#   run records    .nb2cleanpdf/<timestamp>/ (logs, backups, failed copies)
#   temp files     .<name>.ipynb.nb2cleanpdf-tmp next to a notebook (hard kill mid-write)
#   temp dirs      $TMPDIR/nb2cleanpdf.<pid>.XXXXXX whose <pid> is no longer running
#   processes      exec helper / headless browser whose command line points into
#                  such a dead temp dir (hard-killed run). Kernels need no handling:
#                  ipykernel exits by itself once its parent process is gone.
#   PDFs           only with --pdfs: <notebook>.pdf (or under -o DIR)
human_kb() {
  local k=${1:-0}
  if   (( k >= 1048576 )); then printf '%.1f GB' $(( k / 1048576.0 ))
  elif (( k >= 1024 ));    then printf '%.1f MB' $(( k / 1024.0 ))
  else printf '%d KB' $k; fi
}
size_kb() {             # total size of the given paths, in KB -> REPLY
  local l t=0
  (( $# )) || { REPLY=0; return }
  for l in ${(f)"$(command du -sk -- "$@" 2>/dev/null)"}; do (( t += ${l%%[[:space:]]*} )); done
  REPLY=$t
}
pid_alive() { [[ $1 == <-> ]] && kill -0 $1 2>/dev/null }

run_clean() {
  local tmp_root=${${TMPDIR:-/tmp}%/} d f line pid cmd owner k
  local -a live_owners=() stale_tmp=() tmp_files=() runs=() keep_runs=() del_runs=() live_runs=()
  local -a orph_pids=() orph_cmds=() pdfs=()

  # temp dirs: live ones tell us a run is in progress right now
  for d in $tmp_root/nb2cleanpdf.<->.*(N/); do
    owner=${${d:t}#nb2cleanpdf.}; owner=${owner%%.*}
    if pid_alive $owner; then live_owners+=$owner; else stale_tmp+=$d; fi
  done

  # orphaned processes of this user that belong to a dead run's temp dir
  for line in ${(f)"$(command ps -U $UID -o pid= -o command= 2>/dev/null)"}; do
    line=${line##[[:space:]]#}
    pid=${line%%[[:space:]]*}; cmd=${line#*[[:space:]]}
    [[ $cmd =~ 'nb2cleanpdf\.([0-9]+)\.[A-Za-z0-9]{6}' ]] || continue
    owner=$match[1]
    (( pid == $$ )) && continue
    pid_alive $owner && continue
    orph_pids+=$pid; orph_cmds+=$cmd
  done

  # half-written notebook files (skipped while a run is active: they may be in use)
  if (( ! $#live_owners )); then
    tmp_files=( ${(0)"$(command find . -mindepth 1 \( -type d \( -name '.?*' -o -name node_modules \
        -o -name __pycache__ -o -name site-packages \) -prune \) \
        -o \( -type f -name '.*.ipynb.nb2cleanpdf-tmp' -print0 \) 2>/dev/null)"} )
    tmp_files=( ${tmp_files#./} )
  fi

  # run records, newest first; keep the newest $KEEP_RUNS and any still running
  runs=( .nb2cleanpdf/<->-<->(N/On) )
  for d in $runs; do
    if [[ -f $d/.pid ]] && pid_alive "$(<$d/.pid)"; then live_runs+=$d
    elif (( $#keep_runs < KEEP_RUNS )); then keep_runs+=$d
    else del_runs+=$d; fi
  done

  # exported PDFs (opt-in)
  if (( CLEAN_PDFS )); then
    discover; filter_notebooks
    for f in $NBS; do
      d=$PDF_DIR/${f:r}.pdf
      [[ -f $d ]] && pdfs+=$d
    done
  fi

  # ---- report ----
  print -r -- "${C}::${N} ${B}nb2cleanpdf clean${N} — $PWD"
  (( $#live_owners )) && warn "an nb2cleanpdf run is in progress (pid ${(j:, :)live_owners}); its files are left alone"
  local total=$(( $#del_runs + $#tmp_files + $#stale_tmp + $#orph_pids + $#pdfs ))
  local n_backups=0

  if (( $#runs )); then
    size_kb $del_runs; local del_kb=$REPLY
    print -r -- "  ${B}Run records${N}  .nb2cleanpdf/  ${D}$#runs run(s); removing $#del_runs ($(human_kb $del_kb)), keeping $(( $#keep_runs + $#live_runs ))${N}"
    local shown=0
    for d in $runs; do
      local -a b=( $d/backup/**/*.ipynb(N.) ) fl=( $d/failed/*.ipynb(N.) )
      (( ${del_runs[(Ie)$d]} )) && (( n_backups += $#b ))
      (( ++shown > 12 )) && continue
      size_kb $d
      local tag="${R}remove${N}"
      (( ${live_runs[(Ie)$d]} )) && tag="${Y}live${N}  "
      (( ${keep_runs[(Ie)$d]} )) && tag="${G}keep${N}  "
      printf '    %s  %s  %8s   %s\n' "$tag" "${d:t}" "$(human_kb $REPLY)" \
             "${D}$#b backup(s), $#fl failed copy(ies)${N}"
    done
    (( shown > 12 )) && print -r -- "    ${D}… and $(( shown - 12 )) older run(s)${N}"
  fi
  if (( $#tmp_files )); then
    print -r -- "  ${B}Half-written notebook temp files${N}  ${D}$#tmp_files${N}"
    print -rl -- "${tmp_files[@]/#/    }"
  fi
  if (( $#stale_tmp )); then
    size_kb $stale_tmp
    print -r -- "  ${B}Orphaned temp dirs${N}  ${D}$#stale_tmp ($(human_kb $REPLY)) — from runs that were killed${N}"
    print -rl -- "${stale_tmp[@]/#/    }"
  fi
  if (( $#orph_pids )); then
    print -r -- "  ${B}Orphaned processes${N}  ${D}$#orph_pids — helper/browser left by a killed run${N}"
    for k in {1..$#orph_pids}; do printf '    %6s  %s\n' $orph_pids[k] "${orph_cmds[k][1,110]}"; done
  fi
  if (( CLEAN_PDFS )); then
    size_kb $pdfs
    print -r -- "  ${B}Exported PDFs${N}  ${D}$#pdfs ($(human_kb $REPLY))${N}"
    local -a rel=( ${pdfs#$PWD/} )
    (( $#rel )) && print -rl -- "${rel[@]/#/    }"
  fi

  if (( total == 0 )); then
    print -r -- "  ${G}✓ nothing to clean${N}"
    return 0
  fi

  local use_trash=$(( $+commands[trash] ))
  print
  if (( use_trash )); then
    info "run records and PDFs go to the ${B}Trash${N}; temp files/dirs are deleted"
  else
    info "everything above marked for removal is ${B}deleted permanently${N}"
  fi
  (( n_backups )) && warn "this includes $n_backups notebook backup(s) — use --keep N to keep the newest runs"

  (( DRY_RUN )) && { print -r -- "${D}(check only — nothing removed; run without -n to clean)${N}"; return 0 }

  if (( ! ASSUME_YES )); then
    [[ -t 0 ]] || die "no TTY to confirm — re-run with -y to clean without asking"
    local reply
    read -r "reply?${C}::${N} Clean the $total item(s) above? [y/N] " </dev/tty
    [[ $reply == [yY]* ]] || { print -r -- "Nothing removed."; return 0 }
  fi

  # ---- clean: processes first (they hold the temp dirs), then files ----
  local fails=0
  if (( $#orph_pids )); then
    kill -TERM $orph_pids 2>/dev/null
    for k in 1 2 3 4 5 6; do
      local -a left=(); for pid in $orph_pids; do pid_alive $pid && left+=$pid; done
      (( $#left )) || break; sleep 0.5
    done
    (( $#left )) && kill -KILL $left 2>/dev/null
    print -r -- "  ${G}✓${N} stopped $#orph_pids orphaned process(es)"
  fi
  if (( $#stale_tmp )); then
    rm -rf -- $stale_tmp && print -r -- "  ${G}✓${N} removed $#stale_tmp temp dir(s)" || (( fails++ ))
  fi
  if (( $#tmp_files )); then
    rm -f -- $tmp_files && print -r -- "  ${G}✓${N} removed $#tmp_files temp file(s)" || (( fails++ ))
  fi
  local -a to_bin=( ${del_runs:a} $pdfs )
  if (( $#to_bin )); then
    if (( use_trash )); then command trash $to_bin; else rm -rf -- $to_bin; fi
    if (( $? == 0 )); then
      (( $#del_runs )) && print -r -- "  ${G}✓${N} removed $#del_runs run record(s)"
      (( $#pdfs ))     && print -r -- "  ${G}✓${N} removed $#pdfs PDF(s)"
    else
      (( fails++ ))
    fi
  fi
  [[ -d .nb2cleanpdf ]] && rmdir .nb2cleanpdf 2>/dev/null   # only if now empty
  # folders of the PDF dir that are now empty (never the project dir itself)
  (( $#pdfs )) && [[ $PDF_DIR != $PWD && -d $PDF_DIR ]] && \
    command find $PDF_DIR -depth -type d -empty -delete 2>/dev/null
  (( fails )) && die "some items could not be removed (see messages above)"
  print -r -- "${G}${B}Clean.${N}"
}

if [[ $MODE == clean ]]; then
  run_clean
  exit $?
fi

# ---------- 1. the Python environment (required) ------------------------------
# uv (default: ./.venv, must be created by uv), local (any standard venv) or
# conda (a conda / mamba / micromamba env, by name or prefix).
ENV_SRC=$(src env --env)
ENV_LABEL=${ENV_SPEC:-.venv}; [[ $ENV_LABEL == /* ]] && ENV_LABEL=${ENV_LABEL/#$START_DIR\//}
CONDA_MGR=     # conda / mamba / micromamba found on this machine (may stay empty)

other_env_hints() {
  print -ru2 -- "       Or use another environment:"
  hint "$SCRIPT --env local PATH     # python -m venv / virtualenv / poetry / pdm"
  hint "$SCRIPT --env conda NAME     # conda / mamba / micromamba (name or prefix)"
}
find_conda_mgr() {
  local c
  for c in ${CONDA_EXE:-} ${MAMBA_EXE:-} conda mamba micromamba; do
    if [[ $c == /* ]]; then [[ -x $c ]] && { CONDA_MGR=$c; return 0 }
    elif (( $+commands[$c] )); then CONDA_MGR=$c; return 0; fi
  done
  return 1
}
conda_prefix_of() {   # $1 = env name -> prefix (from '<mgr> env list --json')
  local json p
  local -a envs
  json=$("$CONDA_MGR" env list --json 2>/dev/null) || return 1
  json=${${json#*\"envs\"*\[}%%\]*}          # just the "envs": [...] array, any layout
  while [[ $json =~ '"(/[^"]*)"' ]]; do envs+=$match[1]; json=${json[MEND+1,-1]}; done
  for p in $envs; do
    if [[ $1 == base ]]; then [[ $p != */envs/* ]] && { print -r -- $p; return 0 }
    elif [[ ${p:t} == $1 ]]; then print -r -- $p; return 0; fi
  done
  return 1
}

case $ENV_KIND in
  uv)
    if [[ ! -d $ENV_DIR ]]; then
      print -ru2 -- "${ER}error:${EN} no virtualenv found at '$ENV_LABEL' in $PWD"
      print -ru2 -- "       By default notebooks run with a venv created by uv. Create one with:"
      hint "uv init --bare && uv add --dev jupyter   # new project"
      hint "uv sync                                  # existing pyproject.toml"
      hint "uv venv && uv pip install jupyter        # plain venv, no pyproject"
      other_env_hints
      exit 1
    fi
    [[ -d $ENV_DIR/conda-meta ]] && \
      die "'$ENV_LABEL' is a conda environment — use:  $SCRIPT --env conda ${(q)ENV_LABEL}"
    [[ -f $ENV_DIR/pyvenv.cfg ]] || die "'$ENV_LABEL' is not a virtualenv (no pyvenv.cfg)"
    command grep -Eq '^[[:space:]]*uv[[:space:]]*=' $ENV_DIR/pyvenv.cfg || \
      die "'$ENV_LABEL' was not created by uv (pyvenv.cfg has no 'uv =' entry). Either use it as it is:
         $SCRIPT --env local ${(q)ENV_LABEL}
       or recreate it with uv:  rm -rf ${(q)ENV_LABEL} && uv venv   (then reinstall deps, e.g. uv sync)"
    ;;
  local)
    [[ -d $ENV_DIR ]] || die "no virtualenv found at '$ENV_LABEL' ($ENV_SRC)"
    [[ -d $ENV_DIR/conda-meta ]] && \
      die "'$ENV_LABEL' is a conda environment, not a venv — use:  $SCRIPT --env conda ${(q)ENV_LABEL}"
    [[ -f $ENV_DIR/pyvenv.cfg ]] || \
      die "'$ENV_LABEL' is not a virtualenv (no pyvenv.cfg) — create one with:  python3 -m venv ${(q)ENV_LABEL}"
    ;;
  conda)
    find_conda_mgr
    if [[ -z $ENV_DIR ]]; then       # given by name
      [[ -n $CONDA_MGR ]] || die "conda environment '$ENV_SPEC' ($ENV_SRC): no conda, mamba or micromamba found to look it up.
       Give its prefix instead (--env conda /path/to/env), or install one, e.g.:  brew install micromamba"
      ENV_DIR=$(conda_prefix_of $ENV_SPEC) || {
        print -ru2 -- "${ER}error:${EN} no conda environment named '$ENV_SPEC' ($ENV_SRC). Known environments:"
        hint "${CONDA_MGR:t} env list"
        exit 1
      }
      ENV_LABEL="$ENV_SPEC ($ENV_DIR)"
    else
      [[ -d $ENV_DIR ]] || die "no conda environment at '$ENV_LABEL' ($ENV_SRC)"
      [[ -d $ENV_DIR/conda-meta ]] || {
        [[ -f $ENV_DIR/pyvenv.cfg ]] && die "'$ENV_LABEL' is a venv, not a conda environment — use:  $SCRIPT --env local ${(q)ENV_LABEL}"
        die "'$ENV_LABEL' is not a conda environment (no conda-meta/)"
      }
    fi
    ;;
esac
PY=$ENV_DIR/bin/python
[[ -x $PY ]] || die "'$PY' is missing or not executable — the environment '$ENV_LABEL' looks broken (or has no Python: install one into it)"


# ---------- 2. dependency checks (+ optional auto-install) -------------------
# Each missing dependency is recorded with the exact shell command that installs
# it. That command is always printed (manual route); with consent it is also run.
typeset -U path
[[ -d /Library/TeX/texbin ]] && path+=(/Library/TeX/texbin)   # BasicTeX/MacTeX binaries

BREW=${commands[brew]:-}
if [[ -z $BREW ]]; then
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $b ]] && { BREW=$b; path=(${b:h} $path); break }
  done
fi
NO_BREW_NOTE="Homebrew not found — install it first from https://brew.sh (then re-run)"

ENV_REL=${ENV_DIR#$PWD/}
# How packages get into the environment — always its own manager. INST_UV=1:
# the installer is uv (so uv is a dependency); INST_AUTO=0: we can only show the
# command (no manager found).
INST_UV=0 INST_AUTO=1 INST_NOTE= INST_WEBPDF="'nbconvert[webpdf]'"
case $ENV_KIND in
  uv)
    INST_UV=1
    if [[ -f pyproject.toml ]]; then
      INST="uv add --dev"
      [[ $ENV_DIR != $PWD/.venv ]] && INST="UV_PROJECT_ENVIRONMENT=${(q)ENV_REL} $INST"
      INST="$CD_PFX$INST"
      INST_NOTE="adds it to the dev dependency group in pyproject.toml / uv.lock"
    else
      INST="${CD_PFX}uv pip install --python ${(q)ENV_REL}"
    fi ;;
  local)
    if "$PY" -m pip --version &>/dev/null; then
      INST="$CD_PFX${(q)ENV_REL}/bin/python -m pip install"
    else
      INST="${CD_PFX}uv pip install --python ${(q)ENV_REL}" INST_UV=1
      INST_NOTE="the venv has no pip; uv installs into it"
    fi ;;
  conda)
    INST="${CONDA_MGR:t} install -y -p ${(q)ENV_DIR} -c conda-forge" INST_WEBPDF=nbconvert-webpdf
    if [[ -z $CONDA_MGR ]]; then
      INST="conda install -y -p ${(q)ENV_DIR} -c conda-forge" INST_AUTO=0
      INST_NOTE="no conda / mamba / micromamba found — run it with the one that manages this env"
    elif [[ $CONDA_MGR == /* && ${commands[${CONDA_MGR:t}]:-} != $CONDA_MGR ]]; then
      INST="${(q)CONDA_MGR} install -y -p ${(q)ENV_DIR} -c conda-forge"   # not the one on PATH
    fi ;;
esac

# Packages nbconvert's LaTeX template needs (BasicTeX lacks several of them).
TEX_STY=( tcolorbox.sty pgf.sty environ.sty trimspaces.sty upquote.sty adjustbox.sty
          titling.sty enumitem.sty ulem.sty soul.sty mathrsfs.sty eurosym.sty
          booktabs.sty caption.sty fontspec.sty unicode-math.sty )
TEX_PKGS="collection-fontsrecommended tcolorbox pgf environ trimspaces upquote adjustbox titling enumitem ulem soul jknapltx rsfs eurosym booktabs caption fontspec unicode-math"

# Chromium-based browsers already on the Mac; the first one found is reused
# for PDF printing so nothing has to be downloaded.
BROWSER_CANDIDATES=(
  "Google Chrome.app/Contents/MacOS/Google Chrome"
  "Chromium.app/Contents/MacOS/Chromium"
  "Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
  "Brave Browser.app/Contents/MacOS/Brave Browser"
  "Google Chrome Beta.app/Contents/MacOS/Google Chrome Beta"
  "Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary"
)
BROWSER=
find_browser() {
  BROWSER=
  if [[ -n $BROWSER_OPT ]]; then
    local b=${BROWSER_OPT:a}
    if [[ -d $b && $b == *.app ]]; then           # accept an .app bundle
      local -a bins=( $b/Contents/MacOS/*(N*) )
      b=${bins[1]:-}
    fi
    [[ -n $b && -x $b && ! -d $b ]] || die "--browser: '$BROWSER_OPT' is not an executable browser"
    BROWSER=$b; return 0
  fi
  local c d
  for c in $BROWSER_CANDIDATES; do
    for d in /Applications ~/Applications; do
      [[ -x "$d/$c" ]] && { BROWSER="$d/$c"; return 0 }
    done
  done
  for c in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge; do  # Linux / PATH
    (( $+commands[$c] )) && { BROWSER=$commands[$c]; return 0 }
  done
  return 1
}
browser_label() { [[ $BROWSER == *.app/* ]] && print -r -- ${${BROWSER%%.app/*}:t} || print -r -- $BROWSER }

ENGINE_WAS_AUTO=0
if (( DO_PDF )) && [[ $ENGINE == (auto|chrome|chrome-cli) ]]; then find_browser; fi
if [[ $ENGINE == auto ]]; then
  ENGINE_WAS_AUTO=1
  if [[ -n $BROWSER ]] || (( ! DO_PDF )); then ENGINE=chrome; else ENGINE=webpdf; fi
fi

py_has() { "$PY" -c "import $1" &>/dev/null }
chromium_ok() {
  "$PY" - &>/dev/null <<'PYEOF'
from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    p.chromium.launch().close()
PYEOF
}
wants_picker() { (( ! ASSUME_YES )) && [[ -t 0 && -t 1 ]] }

# The chrome engine drives the browser with playwright from an ephemeral env in
# uv's cache, built on the environment's interpreter (any kind): the environment,
# pyproject.toml and uv.lock stay untouched, and nothing is downloaded after the
# first time.
PW_REQ='playwright>=1.49'
PW_RUN="uv run --no-project --python ${(q)ENV_REL}/bin/python --with ${(qq)PW_REQ}"
pw_ok() { (( $+commands[uv] )) && eval "$PW_RUN --offline --quiet python -c 'import playwright'" &>/dev/null }

typeset -a DEP_NAME DEP_REQ DEP_AUTO DEP_CMD DEP_WHY DEP_NOTE
add_dep() {   # name required(0/1) auto-installable(0/1) command why [note]
  DEP_NAME+=("$1"); DEP_REQ+=("$2"); DEP_AUTO+=("$3"); DEP_CMD+=("$4"); DEP_WHY+=("$5"); DEP_NOTE+=("${6:-}")
}

check_deps() {   # $1 = sync | all
  DEP_NAME=() DEP_REQ=() DEP_AUTO=() DEP_CMD=() DEP_WHY=() DEP_NOTE=()
  local has_brew=$(( ${#BREW} > 0 )) brew_note= need_uv=0 m pw=1
  (( has_brew )) || brew_note=$NO_BREW_NOTE

  local -a mods=()
  if [[ $1 == sync ]]; then
    need_uv=1
  else
    (( DO_EXEC )) && for m in nbformat nbclient ipykernel; do py_has $m || mods+=$m; done
    (( DO_PDF ))  && { py_has nbconvert || mods+=nbconvert }
    (( $#mods && INST_UV )) && need_uv=1
    (( DO_PDF && INST_UV )) && [[ $ENGINE == webpdf ]] && ! py_has playwright && need_uv=1
    (( DO_PDF )) && [[ $ENGINE == chrome ]] && ! pw_ok && { pw=0; need_uv=1 }
  fi

  # uv installs into uv envs (and pip-less venvs) and always runs playwright for
  # the chrome engine; other environments are installed into by their own manager
  local uv_auto=1 env_auto=$INST_AUTO
  if (( need_uv && ! $+commands[uv] )); then
    add_dep uv 1 $has_brew "brew install uv" "Python package manager (installs packages / runs playwright)" "$brew_note"
    uv_auto=$has_brew
  fi
  (( INST_UV )) && env_auto=$uv_auto
  [[ $1 == sync ]] && return

  (( $#mods )) && add_dep jupyter 1 $env_auto "$INST jupyter" \
      "the environment lacks: ${mods[*]}" "$INST_NOTE"

  local no_chrome_note=
  (( ENGINE_WAS_AUTO )) && no_chrome_note="no Chrome/Edge/Brave found to reuse; alternatively: brew install --cask google-chrome"

  if (( DO_PDF )) && [[ $ENGINE == (chrome|chrome-cli) ]]; then
    find_browser || add_dep "Google Chrome" 1 $has_brew "brew install --cask google-chrome" \
        "browser used to print PDFs (or pass --browser PATH)" "$brew_note"
    (( pw )) || add_dep playwright 1 $uv_auto "$CD_PFX$PW_RUN python -c 'import playwright'" \
        "drives the browser to print PDFs" \
        "~300 MB in uv's cache (shared, outside your environment); pyproject.toml / uv.lock are not changed"
  elif (( DO_PDF )) && [[ $ENGINE == webpdf ]]; then
    if ! py_has playwright; then
      add_dep "nbconvert[webpdf]" 1 $env_auto "$INST $INST_WEBPDF" \
          "playwright, for HTML→PDF rendering" "$INST_NOTE"
      add_dep chromium 1 $env_auto "$CD_PFX${(q)ENV_REL}/bin/python -m playwright install chromium" \
          "headless browser that prints the PDF" \
          "shared by all projects in ~/Library/Caches/ms-playwright${no_chrome_note:+; $no_chrome_note}"
    elif ! chromium_ok; then
      add_dep chromium 1 1 "$CD_PFX${(q)ENV_REL}/bin/python -m playwright install chromium" \
          "headless browser that prints the PDF" \
          "shared by all projects in ~/Library/Caches/ms-playwright${no_chrome_note:+; $no_chrome_note}"
    fi
  elif (( DO_PDF )); then
    (( $+commands[pandoc] )) || add_dep pandoc 1 $has_brew "brew install pandoc" \
        "converts Markdown cells to LaTeX" "$brew_note"
    local tex_missing=0 sty
    if (( ! $+commands[xelatex] )); then
      add_dep "BasicTeX (xelatex)" 1 $has_brew "brew install --cask basictex" \
          "LaTeX engine" "${brew_note:-asks for your macOS password; ~100 MB}"
      tex_missing=1
    else
      for sty in $TEX_STY; do kpsewhich $sty &>/dev/null || { tex_missing=1; break }; done
    fi
    (( tex_missing )) && add_dep "LaTeX packages" 1 1 \
        "sudo tlmgr update --self && sudo tlmgr install $TEX_PKGS" \
        "used by nbconvert's LaTeX template" "asks for your macOS password"
  fi

  if wants_picker; then
    if (( ! $+commands[fzf] )); then
      add_dep fzf 0 $has_brew "brew install fzf" "picker with previews (text menu otherwise)" "$brew_note"
    else
      local v=${${(s: :)"$(fzf --version 2>/dev/null)"}[1]}
      is-at-least 0.36 $v 2>/dev/null || add_dep "fzf >= 0.36" 0 $has_brew "brew upgrade fzf" \
          "installed fzf $v is too old for the picker" "$brew_note"
    fi
  fi
}

report_deps() {
  local k mark kind
  print; print -r -- "${C}::${N} ${B}dependency check${N}"
  for k in {1..$#DEP_NAME}; do
    if (( DEP_REQ[k] )); then mark="${R}✗${N}" kind=required; else mark="${Y}○${N}" kind=optional; fi
    printf '  %s %-20s %s%-9s%s %s\n' "$mark" "$DEP_NAME[k]" "$D" $kind "$N" "$DEP_WHY[k]"
    print -r -- "        ${D}\$${N} $DEP_CMD[k]"
    [[ -n $DEP_NOTE[k] ]] && print -r -- "        ${D}↳ $DEP_NOTE[k]${N}"
  done
  print
}

ensure_deps() {   # $1 = sync | all
  local round k reply n_req
  local -a todo
  for round in 1 2 3; do
    check_deps $1
    (( $#DEP_NAME )) || return 0
    n_req=${#${(M)DEP_REQ:#1}}

    if (( n_req == 0 && ! INSTALL_DEPS )); then   # only optional ones: a tip, never a prompt
      for k in {1..$#DEP_NAME}; do
        info "tip: ${B}$DEP_CMD[k]${N} — $DEP_WHY[k]  (or --install-deps)"
      done
      return 0
    fi

    report_deps
    (( round == 3 )) && die "dependencies still missing after installation — see the list above"

    todo=()
    for k in {1..$#DEP_NAME}; do (( DEP_AUTO[k] )) && todo+=$k; done
    if (( ! $#todo )); then
      print -ru2 -- "${ER}error:${EN} none of these can be installed automatically — run the commands above yourself, then re-run."
      exit 1
    fi

    if (( INSTALL_DEPS )); then
      info "installing $#todo item(s) (--install-deps)…"
    elif [[ -t 0 && -t 1 ]]; then
      (( $#todo < $#DEP_NAME )) && warn "items marked with ↳ Homebrew need manual installation; the rest can be done now"
      read -r "reply?${C}::${N} Install the $#todo item(s) above now? [y/N] " </dev/tty
      if [[ $reply != [yY]* ]]; then
        print -r -- "Not installing. Run the commands above manually (or re-run with --install-deps)."
        exit 1
      fi
    else
      print -ru2 -- "${ER}error:${EN} missing dependencies and no TTY to ask — run the commands above, or re-run with --install-deps"
      exit 1
    fi

    for k in $todo; do
      print -r -- "${C}::${N} ${B}$DEP_NAME[k]${N}: ${D}$DEP_CMD[k]${N}"
      if ! eval "$DEP_CMD[k]"; then
        print -ru2 -- "${ER}error:${EN} installing '$DEP_NAME[k]' failed (command above). Fix it and re-run."
        exit 1
      fi
      rehash
    done
    info "re-checking dependencies…"
  done
}

if (( ! DRY_RUN )); then
  if (( DO_SYNC )); then
    [[ -f pyproject.toml ]] || die "--sync needs a pyproject.toml in $PWD"
    ensure_deps sync
    info "uv sync"
    UV_PROJECT_ENVIRONMENT=$ENV_DIR uv sync || die "'uv sync' failed"
  fi
  ensure_deps all
  if (( DO_PDF )); then
    case $ENGINE in
      chrome)     info "PDF engine: ${B}chrome${N} — reusing $(browser_label) via playwright" ;;
      chrome-cli) info "PDF engine: ${B}chrome-cli${N} — reusing $(browser_label) (headless print)" ;;
      webpdf) info "PDF engine: ${B}webpdf${N} — playwright's Chromium" ;;
      latex)  info "PDF engine: ${B}latex${N} — xelatex" ;;
    esac
  fi
