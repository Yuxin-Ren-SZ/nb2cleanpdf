if (( DO_PDF )) && [[ $ENGINE == chrome ]]; then
  cat >$TMP/chrome_pdf.py <<'PYEOF'
# Print an nbconvert HTML file to PDF with an existing Chrome-family browser.
import os, pathlib, signal, subprocess, sys, time
browser, html, pdf, profile, timeout = sys.argv[1:6]
page = pathlib.Path(html)
# same as playwright's print_background=True: keep code-cell / table backgrounds
css = "<style>*{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}</style>"
text = page.read_text(encoding="utf-8")
text = text.replace("</head>", css + "</head>", 1) if "</head>" in text else css + text
page.write_text(text, encoding="utf-8")
cmd = [browser, "--headless=new", "--disable-gpu", "--hide-scrollbars",
       "--no-first-run", "--no-default-browser-check", "--disable-extensions",
       f"--user-data-dir={profile}",           # throw-away profile: never touches your real one
       "--no-pdf-header-footer", "--print-to-pdf-no-header",   # new + old flag spelling
       "--virtual-time-budget=20000",          # let MathJax etc. finish before printing
       f"--print-to-pdf={pdf}", page.resolve().as_uri()]
out = pathlib.Path(pdf)
out.unlink(missing_ok=True)

def pdf_complete():
    # Chrome (seen with 153 on macOS) may write the PDF and then never exit,
    # so don't wait for the process: wait for a finished, stable file.
    try:
        size = out.stat().st_size
        with out.open("rb") as fh:
            fh.seek(max(0, size - 64)); tail = fh.read()
    except OSError:
        return False
    if size == 0 or b"%%EOF" not in tail: return False
    time.sleep(0.5)
    return out.stat().st_size == size

# own process group, so the browser and all its helpers can be stopped together
p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, start_new_session=True)
deadline, rc = time.monotonic() + float(timeout), 1
try:
    while True:
        if pdf_complete(): rc = 0; break
        if p.poll() is not None:
            rc = 0 if pdf_complete() else 1
            if rc: print(f"browser exited with status {p.returncode} and wrote no PDF", file=sys.stderr)
            break
        if time.monotonic() > deadline:
            print(f"browser did not finish within {timeout}s", file=sys.stderr); break
        time.sleep(0.2)
finally:
    if p.poll() is None:
        try: os.killpg(p.pid, signal.SIGTERM)
        except ProcessLookupError: pass
        try: p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try: os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError: pass
            p.wait()
sys.exit(rc)
PYEOF
fi

if (( DO_EXEC )); then
  # A throw-away kernelspec that points at the venv's interpreter, isolated from
  # any user/system kernelspecs that might shadow "python3".
  KERNEL_NAME="nbrerun-$$"
  mkdir -p $TMP/jupyter/kernels/$KERNEL_NAME
  "$PY" - $TMP/jupyter/kernels/$KERNEL_NAME/kernel.json "$PY" <<'PYEOF' || die "could not write kernelspec"
import json, sys
json.dump({"argv": [sys.argv[2], "-m", "ipykernel_launcher", "-f", "{connection_file}"],
           "display_name": "nbrerun (uv venv)", "language": "python",
           "metadata": {"debugger": False}}, open(sys.argv[1], "w"))
PYEOF
  export JUPYTER_PATH="$TMP/jupyter${JUPYTER_PATH:+:$JUPYTER_PATH}"
  export JUPYTER_PLATFORM_DIRS=1 PYDEVD_DISABLE_FILE_VALIDATION=1
  # make `!python`, `!pip`, subprocess, etc. inside notebooks resolve to the venv
  export VIRTUAL_ENV=$VENV PATH="$VENV/bin:$PATH"
  # env vars that make runs non-reproducible (MPLBACKEND=macosx would pop windows
  # instead of rendering inline plots)
  unset MPLBACKEND PYTHONSTARTUP

  cat >$TMP/exec.py <<'PYEOF'
import os, shutil, sys, time, traceback
import nbformat
from nbclient import NotebookClient
from nbclient.exceptions import CellExecutionError, CellTimeoutError, DeadKernelError

src, kernel, timeout, allow_errors, failed_copy, progress, errfile = sys.argv[1:8]
timeout = None if int(timeout) <= 0 else int(timeout)
t0 = time.time()

def err(msg):
    print(msg, file=sys.stderr)                       # full log
    with open(errfile, "a", encoding="utf-8") as fh:  # short summary shown on screen
        fh.write(msg + "\n")

def tty(msg):
    if progress == "1":
        try: os.write(3, msg.encode())
        except OSError: pass

nb = nbformat.read(src, as_version=4)
ks = nb.metadata.get("kernelspec")
lang = ((ks or {}).get("language") or nb.metadata.get("language_info", {}).get("name") or "python").lower()
if lang != "python":
    err(f"notebook uses a non-Python kernel ({(ks or {}).get('name')}, language={lang}); skipped")
    sys.exit(3)

# start from a clean slate: no outputs, no execution counts, no timing metadata
for cell in nb.cells:
    if cell.cell_type == "code":
        cell.outputs = []
        cell.execution_count = None
        cell.metadata.pop("execution", None)

n = len(nb.cells)
client = NotebookClient(
    nb, kernel_name=kernel, timeout=timeout, allow_errors=(allow_errors == "1"),
    record_timing=False,
    resources={"metadata": {"path": os.path.dirname(os.path.abspath(src))}},  # cwd = notebook dir
)
client.on_cell_start = lambda cell, cell_index: tty(
    f"\r\033[K  \033[2m▶ executing… cell {cell_index + 1}/{n}  ({time.time() - t0:.0f}s)\033[0m")

rc = 0
try:
    client.execute()
except CellTimeoutError as e:
    err(f"cell timed out: {e}"); rc = 4
except CellExecutionError as e:
    err(str(e).strip()); rc = 1
except DeadKernelError as e:
    err(f"kernel died: {e}"); rc = 5
except Exception:
    err(traceback.format_exc().strip()); rc = 2

# don't leak the temporary kernel name into the saved notebook
if ks is not None: nb.metadata["kernelspec"] = ks
else: nb.metadata.pop("kernelspec", None)

if rc == 0:
    d, name = os.path.split(os.path.abspath(src))
    tmp = os.path.join(d, f".{name}.nbrerun-tmp")
    try:
        nbformat.write(nb, tmp)
        shutil.copymode(src, tmp)
        os.replace(tmp, src)            # atomic: original is never half-written
    finally:
        if os.path.exists(tmp): os.remove(tmp)
else:
    os.makedirs(os.path.dirname(failed_copy), exist_ok=True)
    nbformat.write(nb, failed_copy)     # partially executed copy, for debugging
    print(f"\npartially executed copy: {failed_copy}", file=sys.stderr)
sys.exit(rc)
PYEOF
fi

# ---------- 5. interactive (un)selection -------------------------------------
select_fzf() {
  local out
  out=$(print -rl -- "${NBS[@]}" | fzf --multi --reverse --height=85% \
          --bind 'load:select-all' --bind 'ctrl-a:toggle-all' \
          --prompt='notebooks> ' --marker='✓' \
          --header=$'All notebooks start selected — unselect the ones to skip.\nTAB toggle · CTRL-A toggle all · ENTER confirm · ESC abort' \
          --preview "${(q)PY} ${(q)TMP}/preview.py {}" --preview-window='right,55%,wrap')
  local rc=$?
  (( rc == 130 )) && die "aborted"
  (( rc != 0 )) && die "fzf exited with status $rc"
  NBS=( ${(f)out} )
}

select_menu() {
  local i tok a b k reply
  print
  for i in {1..$#NBS}; do printf '  %s%3d)%s %s\n' "$D" $i "$N" "$NBS[i]"; done
  print
  read -r "reply?Numbers/ranges to ${B}EXCLUDE${N} (e.g. '2 5-7'), Enter = keep all, q = quit: " </dev/tty
  [[ $reply == [qQ]* ]] && die "aborted"
  local -A drop
  for tok in ${=reply//,/ }; do
    if [[ $tok == <->-<-> ]]; then
      a=${tok%-*} b=${tok#*-}; for (( k=a; k<=b; k++ )); do drop[$k]=1; done
    elif [[ $tok == <-> ]]; then drop[$tok]=1
    else warn "ignoring '$tok'"; fi
  done
  local -a kept=()
  for i in {1..$#NBS}; do (( ${+drop[$i]} )) || kept+=("$NBS[i]"); done
  NBS=( "${kept[@]}" )
}

if (( ! ASSUME_YES )); then
  if [[ -t 0 && -t 1 ]]; then
    if (( FZF_OK )); then select_fzf; else
      select_menu
    fi
    (( $#NBS )) || die "nothing selected"
    print; info "${B}$#NBS${N} notebook(s) selected:"
    print -rl -- "${NBS[@]/#/    }"
    what=(); (( DO_EXEC )) && what+="re-run (in place)"; (( DO_PDF )) && what+="export PDF ($ENGINE)"
    read -r "reply?${C}::${N} ${(j: + :)what}? [Y/n] " </dev/tty
    [[ -z $reply || $reply == [yY]* ]] || die "aborted"
  else
    info "no TTY — skipping interactive selection (use -y to silence this)"
  fi
fi

# ---------- 6. run ------------------------------------------------------------
RUN_DIR=$PWD/.nbrerun/$(strftime %Y%m%d-%H%M%S $EPOCHSECONDS)
mkdir -p $RUN_DIR/logs || die "cannot create $RUN_DIR"
print -r -- $$ >$RUN_DIR/.pid          # marks the run as live for `nbrerun clean`
typeset -A EXEC_ST PDF_ST LOGS
typeset -a DONE=()

elapsed() { printf '%.1fs' $(( EPOCHREALTIME - $1 )) }

export_pdf() {   # $1 notebook, $2 log, $3 index -> writes PDF, returns status
  local nb=$1 log=$2 out=$TMP/pdf/$3 dest
  if [[ -n $PDF_DIR ]]; then dest=$PDF_DIR/${nb:r}.pdf; else dest=$PWD/${nb:r}.pdf; fi
  mkdir -p $out
  local -a args=( --output-dir $out --output out )
  case $ENGINE in
    chrome) args+=( --to html --template webpdf --embed-images ) ;;
    webpdf) args+=( --to webpdf --embed-images ) ;;
    latex)  args+=( --to pdf ) ;;
  esac
  print -r -- "---- nbconvert ($ENGINE) $(strftime '%F %T' $EPOCHSECONDS)" >>$log
  ( cd -- ${nb:h} && "$PY" -m nbconvert "${args[@]}" "./${nb:t}" ) >>$log 2>&1 || return 1
  if [[ $ENGINE == chrome ]]; then
    local -a htmls=( $out/*.html(N) )
    (( $#htmls == 1 )) || { print -r -- "nbconvert produced no HTML" >>$log; return 1 }
    print -r -- "---- $BROWSER --print-to-pdf" >>$log
    "$PY" $TMP/chrome_pdf.py "$BROWSER" $htmls[1] $out/out.pdf $TMP/chrome-profile $PDF_TIMEOUT >>$log 2>&1 || return 1
  fi
  local -a produced=( $out/*.pdf(N) )
  (( $#produced == 1 )) || { print -r -- "nbconvert produced no PDF" >>$log; return 1 }
  mkdir -p -- ${dest:h} && mv -f -- $produced[1] $dest || return 1
  REPLY=${dest#$PWD/}
}

show_tail() { tail -n ${2:-15} -- $1 | cut -c1-220 | sed 's/^/    │ /'; true }
show_pdf_error() {   # LaTeX errors ("! ...") are buried in a huge transcript; surface them
  local -a errs=( ${(f)"$(command grep -oE '! [^\\]{3,200}' -- $1 | command grep -v '^! Emergency stop' | awk '!seen[$0]++' | head -n 5)"} )
  if (( $#errs )); then print -rl -- "${errs[@]/#/    │ }"; else show_tail $1 12; fi
}

total=$#NBS
T_START=$EPOCHREALTIME
for (( i = 1; i <= total; i++ )); do
  (( INTERRUPTED )) && break
  nb=$NBS[i]
  slug="$(printf '%03d' $i)_${${nb:r}//\//__}"
  log=$RUN_DIR/logs/$slug.log
  LOGS[$nb]=$log
  DONE+=("$nb")
  print -r -- "${C}[$i/$total]${N} ${B}$nb${N}"
  print -r -- "==== $nb" >$log

  exec_ok=1
  if (( DO_EXEC )); then
    if (( DO_BACKUP )); then
      mkdir -p -- $RUN_DIR/backup/${nb:h} && cp -p -- $nb $RUN_DIR/backup/$nb
    fi
    t0=$EPOCHREALTIME
    : >$TMP/err
    (( IS_TTY )) && print -n -- "  ${D}▶ executing…${N}"
    "$PY" $TMP/exec.py "$nb" "$KERNEL_NAME" "$TIMEOUT" "$ALLOW_ERRORS" \
        "$RUN_DIR/failed/$slug.ipynb" "$IS_TTY" "$TMP/err" 3>&1 >>$log 2>&1
    rc=$?
    (( IS_TTY )) && print -n -- "$EL"
    if (( INTERRUPTED )); then
      EXEC_ST[$nb]=interrupted; print -r -- "  ${Y}■ interrupted${N} (notebook left untouched)"; break
    fi
    case $rc in
      0) EXEC_ST[$nb]=ok;      print -r -- "  ${G}✓ executed${N} $(elapsed $t0)" ;;
      3) EXEC_ST[$nb]=skipped; print -r -- "  ${Y}– skipped${N}: non-Python kernel" ;;
      4) EXEC_ST[$nb]=timeout; print -r -- "  ${R}✗ cell timed out${N} after $(elapsed $t0) — notebook left untouched" ;;
      *) EXEC_ST[$nb]=FAILED;  print -r -- "  ${R}✗ execution failed${N} after $(elapsed $t0) — notebook left untouched" ;;
    esac
    if (( rc != 0 )); then
      exec_ok=0
      (( rc != 3 )) && show_tail $TMP/err 25 && print -r -- "    partial copy: ${RUN_DIR#$PWD/}/failed/$slug.ipynb"
      print -r -- "    full log:     ${log#$PWD/}"
    fi
  else
    EXEC_ST[$nb]=-
  fi

  if (( DO_PDF )); then
    if (( ! exec_ok )); then
      PDF_ST[$nb]=skipped; print -r -- "  ${D}– PDF skipped (execution did not succeed)${N}"
    else
      t0=$EPOCHREALTIME
      (( IS_TTY )) && print -n -- "  ${D}▶ exporting PDF…${N}"
      export_pdf "$nb" "$log" $i; rc=$?
      (( IS_TTY )) && print -n -- "$EL"
      if (( INTERRUPTED )); then PDF_ST[$nb]=interrupted; print -r -- "  ${Y}■ interrupted${N}"; break; fi
      if (( rc == 0 )); then
        PDF_ST[$nb]=ok; print -r -- "  ${G}✓ PDF${N} → $REPLY ($(elapsed $t0))"
      else
        PDF_ST[$nb]=FAILED; print -r -- "  ${R}✗ PDF export failed${N}"; show_pdf_error $log
        print -r -- "    full log: ${log#$PWD/}"
      fi
    fi
  else
    PDF_ST[$nb]=-
  fi
done

# ---------- 7. summary ----------------------------------------------------------
fmt() {   # colourised, fixed-width status cell
  local t=${(r:12:)1}
  case $1 in
    ok)             print -rn -- "${G}${t}${N}" ;;
    FAILED|timeout) print -rn -- "${R}${t}${N}" ;;
    -)              print -rn -- "${D}${t}${N}" ;;
    *)              print -rn -- "${Y}${t}${N}" ;;
  esac
}
print; print -r -- "${B}Summary${N}  ($(elapsed $T_START) total)"
print -r -- "  ${D}EXEC        PDF         NOTEBOOK${N}"
n_fail=0
for nb in "${DONE[@]}"; do
  print -r -- "  $(fmt ${EXEC_ST[$nb]:--})$(fmt ${PDF_ST[$nb]:--})$nb"
  [[ ${EXEC_ST[$nb]} == (FAILED|timeout) || ${PDF_ST[$nb]} == FAILED ]] && (( n_fail++ ))
done
(( INTERRUPTED )) && print -r -- "  ${Y}interrupted — $(( total - $#DONE )) notebook(s) not processed${N}"
print
print -r -- "  logs:     ${RUN_DIR#$PWD/}/logs/"
(( DO_BACKUP )) && print -r -- "  backups:  ${RUN_DIR#$PWD/}/backup/   (originals before re-run)"
[[ -d $RUN_DIR/failed ]] && print -r -- "  failed:   ${RUN_DIR#$PWD/}/failed/   (partially executed copies)"
[[ -f .gitignore ]] && ! command grep -qx '\.nbrerun/\?' .gitignore && \
  print -r -- "  ${D}tip: add '.nbrerun/' to .gitignore${N}"

if (( INTERRUPTED )); then exit 130; fi
if (( n_fail )); then print -r -- "${R}${B}$n_fail notebook(s) had errors.${N}"; exit 1; fi
print -r -- "${G}${B}All done.${N}"
