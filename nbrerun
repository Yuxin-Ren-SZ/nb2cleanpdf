cells = nb.get("cells", [])
src = lambda c: "".join(c.get("source", "")) if isinstance(c.get("source"), list) else c.get("source", "")
code = [c for c in cells if c.get("cell_type") == "code"]
ks = nb.get("metadata", {}).get("kernelspec", {}) or {}
st = os.stat(p)
print(p)
print(f"size     {st.st_size/1024:,.1f} KiB   modified {time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))}")
print(f"cells    {len(cells)} total, {len(code)} code, {sum(bool(c.get('outputs')) for c in code)} with output")
print(f"kernel   {ks.get('display_name', '?')} ({ks.get('language', '?')})")
print("─" * 48)
for c in cells[:8]:
    lines = src(c).splitlines()
